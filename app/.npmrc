# onnxruntime-node (used only by a local `npm run embed`) otherwise downloads CUDA
# binaries on every install (A75). Read by its postinstall as npm_config_*, so it also
# applies to the `npm ci` inside the Foundry gate workflow, which takes no env from us.
onnxruntime-node-install=skip
# Supply chain (A89): npm >= 11.10 resolves no version published less than 7 days ago
# (most hijacked releases are pulled within that window). `npm ci` installs the lockfile
# as is; older npm ignores the key.
min-release-age=7

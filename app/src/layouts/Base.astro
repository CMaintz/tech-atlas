---
import '../styles/global.css';
import { UI, swapLang, url, type Lang } from '../lib/site';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
}
const { lang = 'en', title = 'Atlas', description } = Astro.props;
const ui = UI[lang];
const other: Lang = lang === 'en' ? 'da' : 'en';
const path = Astro.url.pathname;
const alternates = (['en', 'da'] as const).map((l) => ({
  lang: l,
  href: new URL(swapLang(path, l), Astro.site).href,
}));
const pageTitle = title === 'Atlas' ? 'Atlas' : `${title} — Atlas`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? ui.tagline} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
  </head>
  <body class="min-h-screen bg-neutral-950 font-sans text-neutral-100 antialiased">
    <header class="flex items-center justify-between border-b border-neutral-800 px-6 py-4">
      <a href={url(`${lang}/`)} class="font-mono text-lg tracking-tight">atlas</a>
      <nav class="flex gap-5 text-sm text-neutral-400">
        <a class="hover:text-neutral-100" href={url(`${lang}/`)}>{ui.index}</a>
        <a class="hover:text-neutral-100" href={url(`${lang}/compare/`)}>{ui.compare}</a>
        <a class="hover:text-neutral-100" href={swapLang(path, other)} hreflang={other}>
          {other.toUpperCase()}
        </a>
      </nav>
    </header>
    <main class="mx-auto max-w-3xl px-6 py-10">
      <slot />
    </main>
  </body>
</html>

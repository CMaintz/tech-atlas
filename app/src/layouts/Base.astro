---
import '../styles/global.css';
import BackToTop from '../components/BackToTop.astro';
import BetaRibbon from '../components/BetaRibbon.astro';
import LangSuggest from '../components/LangSuggest.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHead from '../components/SiteHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteTour from '../components/SiteTour.astro';
import { UI, url, type Lang } from '../lib/site';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  /** Full-width main area (the Explorer). */
  wide?: boolean;
  /** Greet first-time visitors with the tour (off on e.g. the 404 page). */
  tourAutoStart?: boolean;
  /** og:type — 'article' for entries. */
  ogType?: 'website' | 'article';
  /** Keep out of search engines (the 404 page); also drops canonical + og:url. */
  noindex?: boolean;
  /** Structured data for this page (schema.org JSON-LD), e.g. a DefinedTerm. */
  jsonLd?: Record<string, unknown>;
}
const {
  lang = 'en',
  title = 'Atlas',
  description,
  wide = false,
  tourAutoStart = true,
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;
const ui = UI[lang];
---

<!doctype html>
<html lang={lang} data-lang-base={url(`${lang}/`)}>
  <head>
    <SiteHead
      lang={lang}
      title={title}
      description={description}
      ogType={ogType}
      noindex={noindex}
      jsonLd={jsonLd}
    />
  </head>
  <body class="flex min-h-dvh flex-col bg-bg font-sans text-fg antialiased">
    {/* Blocking, before any content is parsed, so there is no flash of the wrong theme.
        Not in <head>: Astro appends the CSP meta there last, and nothing may
        run before the policy. */}
    <script is:inline src={url('theme-init.js')}></script>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-amber-400 focus:px-3 focus:py-2 focus:text-on-accent"
    >
      {ui.skipToContent}
    </a>
    <SiteHeader lang={lang} />
    {lang === 'en' && !wide && <LangSuggest />}
    <main
      id="main"
      tabindex="-1"
      class={wide ? '' : 'mx-auto w-full max-w-5xl flex-1 px-4 py-10 sm:px-6'}
    >
      <slot />
    </main>
    {!wide && <SiteFooter lang={lang} />}
    {!wide && <BackToTop label={ui.backToTop} />}
    <SiteTour lang={lang} autoStart={tourAutoStart} />
    <script>
      import { initBackToTop } from '../lib/chrome/back-to-top';
      import { initCopyLinks } from '../lib/chrome/copy-link';
      import { initDropdowns } from '../lib/chrome/dropdowns';
      import { initLangSuggest } from '../lib/chrome/lang-suggest';
      import { initMobileMenu } from '../lib/chrome/mobile-menu';
      import { initSearchShortcut } from '../lib/chrome/search-shortcut';
      import { initThemeMenu } from '../lib/chrome/theme-menu';

      // Pages can't send frame-ancestors / X-Frame-Options: refuse to render
      // inside another site's frame, so account actions can't be clickjacked.
      if (window.top !== window.self) document.documentElement.style.display = 'none';

      // Document-level key and click listeners run in the order these add them.
      initMobileMenu();
      initThemeMenu(initDropdowns());
      initSearchShortcut();
      initLangSuggest();
      initBackToTop();
      initCopyLinks();
    </script>
    <BetaRibbon lang={lang} />
  </body>
</html>

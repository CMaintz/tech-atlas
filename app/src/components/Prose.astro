---
import type { Segment } from '../lib/autolink';
import { termUrl, type Lang } from '../lib/site';

interface Props {
  segments: Segment[];
  lang: Lang;
}
const { segments, lang } = Astro.props;
---

{segments.map((s) =>
  s.id ? (
    <a
      class="underline decoration-subtle underline-offset-2 hover:decoration-fg-soft"
      href={termUrl(lang, s.id)}
      set:text={s.text}
    />
  ) : (
    s.text
  ),
)}

---
/**
 * How to put it into practice: the steps in order, the common pitfalls and good
 * guides, the reader's language first. Absent when the term has no how-to.
 */
import { DEEP_UI, type Lang } from '../../lib/site';
import { guidesFor } from '../../lib/term-panel';
import type { HowToGuide } from '../../schema';
import type { TermEntry } from '../../lib/terms';

interface Props {
  lang: Lang;
  term: TermEntry;
}

const { lang, term } = Astro.props;
const deep = DEEP_UI[lang];
const howTo = term.data.howTo;
const guides = howTo ? guidesFor<HowToGuide>(howTo.guides, lang) : [];
---

{howTo && (
  <section class="mt-10" id="how-to" aria-labelledby="how-to-title">
    <h2 id="how-to-title" class="mb-1 text-xs tracking-widest text-subtle uppercase">
      {deep.howTo}
    </h2>
    <p class="mb-3 text-sm text-subtle">{deep.howToIntro}</p>
    <ol class="space-y-3">
      {howTo.steps[lang].map((s, i) => (
        <li class="flex gap-3">
          <span
            aria-hidden="true"
            class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-border-strong text-xs font-semibold text-fg"
          >
            {i + 1}
          </span>
          <span class="leading-relaxed text-fg-soft">{s}</span>
        </li>
      ))}
    </ol>
    {howTo.pitfalls && howTo.pitfalls[lang].length > 0 && (
      <div class="mt-5 rounded border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-300">
        <h3 class="mb-1 font-semibold">{deep.pitfalls}</h3>
        <ul class="list-disc space-y-1 pl-5">
          {howTo.pitfalls[lang].map((p) => (
            <li>{p}</li>
          ))}
        </ul>
      </div>
    )}
    <h3 class="mt-5 mb-1 text-xs tracking-widest text-subtle uppercase">{deep.guides}</h3>
    <ul class="space-y-1 text-sm">
      {guides.map((g) => (
        <li>
          <a
            class="inline-flex min-h-11 items-center gap-1.5 text-fg underline-offset-2 hover:underline sm:min-h-0"
            href={g.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {g.title}
            <svg
              aria-hidden="true"
              class="h-3.5 w-3.5 shrink-0 text-subtle"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
            </svg>
            <span class="sr-only">{deep.opensNewTab}</span>
          </a>
          <span class="text-subtle">
            {' · '}
            {g.publisher}
            {g.other && ` (${deep.guideOtherLang})`}
          </span>
        </li>
      ))}
    </ul>
  </section>
)}

---
/**
 * The top of a term's page: breadcrumb, name (with Copy link), other names, summary,
 * the Disambiguation link, the draft notice and the article link.
 */
import { UI, url, type Lang } from '../../lib/site';
import { bareName, collisionsOf } from '../../lib/collisions';
import { termCrumbs } from '../../lib/term-page';
import type { TermEntry } from '../../lib/terms';

interface Props {
  lang: Lang;
  term: TermEntry;
  all: TermEntry[];
}

const { lang, term, all } = Astro.props;
const ui = UI[lang];
const d = term.data;
const aka = d.aka[lang];
const crumbs = termCrumbs(term, lang, ui.index);

// A Collision (ADR-0003): other terms share this bare name — link the Disambiguation page.
const name = bareName(term.id);
const collides = collisionsOf(all.map((t) => t.id)).has(name);
---

<nav aria-label={ui.breadcrumb} class="mb-2 text-xs tracking-widest text-subtle uppercase">
  <ol class="flex flex-wrap items-center gap-x-1.5">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-x-1.5">
        {i > 0 && <span aria-hidden="true">›</span>}
        <a class="inline-flex min-h-11 items-center hover:text-fg-soft sm:min-h-0" href={c.href}>
          {c.label}
        </a>
      </li>
    ))}
  </ol>
</nav>
<div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
  <h1 class="text-3xl font-semibold">{d.term[lang]}</h1>
  <button
    type="button"
    data-copy-link
    data-copied={ui.linkCopied}
    class="mt-1.5 min-h-11 rounded border border-border px-3 py-1 text-sm text-muted sm:min-h-0 sm:px-2 sm:text-xs hover:border-border-hover hover:text-fg print:hidden"
  >
    <span data-label>{ui.copyLink}</span>
  </button>
</div>
{aka.length > 0 && (
  <p class="mt-1 text-sm text-subtle">
    {ui.aka}: {aka.join(', ')}
  </p>
)}
<p class="mt-3 text-lg text-fg-soft">{d.summary[lang]}</p>

{collides && (
  <p class="mt-3 text-sm">
    <a class="text-muted underline hover:text-fg" href={url(`${lang}/terms/${name}/`)}>
      {ui.otherMeanings.replace('{name}', name.replace(/-/g, ' '))}
    </a>
  </p>
)}

{d.draft && (
  <p class="mt-4 rounded border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-900 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-300">
    {ui.draft}
  </p>
)}

{d.article?.[lang] && (
  <p class="mt-6">
    <a
      class="inline-flex min-h-11 items-center text-fg underline hover:text-fg sm:min-h-0"
      href={url(`${lang}/articles/${term.id}/`)}
    >
      {ui.readArticle}
    </a>
  </p>
)}

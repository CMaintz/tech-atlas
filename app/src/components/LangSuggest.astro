---
/**
 * On an English page, a hidden bar offering the Danish one, always in Danish.
 * lib/chrome/lang-suggest.ts shows it to readers whose browser prefers Danish.
 */
import { UI, swapLang } from '../lib/site';

const path = Astro.url.pathname;
---

<div
  id="lang-suggest"
  lang="da"
  hidden
  class="border-b border-border bg-surface px-4 py-2 text-sm text-fg-soft sm:px-6 lg:px-8 print:hidden"
>
  <div class="mx-auto flex max-w-page flex-wrap items-center gap-x-4 gap-y-1">
    <span>{UI.da.langSuggest}</span>
    <a class="text-accent hover:underline" href={swapLang(path, 'da')} hreflang="da">
      {UI.da.langSwitch}
    </a>
    <button type="button" class="text-subtle hover:text-fg-soft" data-lang-keep>
      {UI.da.langKeep}
    </button>
  </div>
</div>

---
/**
 * Beta ribbon: fixed corner watermark, never blocks clicks, hidden in print. Below md
 * it would cover content and the tour pill, so the header carries a badge instead.
 */
import type { Lang } from '../lib/site';

interface Props {
  lang: Lang;
}
---

<div
  aria-hidden="true"
  class="pointer-events-none fixed bottom-0 left-0 z-50 hidden h-32 w-32 overflow-hidden md:block print:hidden"
>
  <div class="absolute bottom-[26px] left-[-44px] w-[180px] rotate-45 bg-amber-400/90 py-1.5 text-center text-sm font-bold tracking-[0.3em] text-on-accent shadow-lg shadow-black/40">
    BETA
  </div>
</div>
<p class="sr-only">{Astro.props.lang === 'da' ? 'Atlas er i beta.' : 'Atlas is in beta.'}</p>

---
/** "Copy link" beside a page title; lib/chrome/copy-link.ts copies the page URL. */
import { UI, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
}
const ui = UI[Astro.props.lang];
---

<button
  type="button"
  data-copy-link
  data-copied={ui.linkCopied}
  class="mt-1.5 min-h-11 rounded border border-border px-3 py-1 text-sm text-muted sm:min-h-0 sm:px-2 sm:text-xs hover:border-border-hover hover:text-fg print:hidden"
>
  <span data-label>{ui.copyLink}</span>
</button>

---
import Base from '../../../layouts/Base.astro';
import Explorer from '../../../components/Explorer';
import ExplorerStage from '../../../components/ExplorerStage.astro';
import { mapIslandProps } from '../../../lib/map-props';
import { LANGS, SEMANTIC_SEARCH_URL, UI, type Lang } from '../../../lib/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Base lang={lang} title={UI[lang].explorer} wide>
  <ExplorerStage lang={lang}>
    <Explorer
      client:only="preact"
      lang={lang}
      {...mapIslandProps(lang)}
      semanticUrl={SEMANTIC_SEARCH_URL}
    />
  </ExplorerStage>
</Base>

<style is:global>
  /*
   * The legend scales with the screen: a wider collapsed pill on big screens and a
   * wider open box. The bar's left inset follows it (`--xp-legend[-open]`), so the two
   * never meet; the right inset keeps the About "i" clear.
   */
  #explorer {
    --xp-legend-w: clamp(18rem, 22vw, 28rem);
    --xp-legend: 9rem;
    --xp-legend-open: calc(var(--xp-legend-w) + 1.5rem);
  }
  #explorer [data-explorer-legend] details[open] {
    width: var(--xp-legend-w);
  }
  @media (min-width: 1440px) {
    #explorer {
      --xp-legend: 11.5rem;
    }
    #explorer [data-explorer-legend] details:not([open]) {
      min-width: 10rem;
      padding-block: 0.625rem;
    }
    #explorer [data-explorer-legend] summary {
      font-size: 0.8125rem;
    }
  }
</style>

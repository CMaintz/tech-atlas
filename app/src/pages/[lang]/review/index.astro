---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import { LANGS, REPO, UI, clusterLabel, termUrl, type Lang } from '../../../lib/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const ui = UI[lang];
const terms = await getCollection('terms');
const drafts = terms.filter((t) => t.data.draft);
const reviewed = terms.length - drafts.length;

const byCluster = new Map<string, typeof drafts>();
for (const t of drafts)
  byCluster.set(t.data.cluster, [...(byCluster.get(t.data.cluster) ?? []), t]);
const clusters = [...byCluster.entries()].sort((a, b) => b[1].length - a[1].length);
const editUrl = (id: string) => `${REPO}/edit/main/app/src/content/terms/${id}.yaml`;
---

<Base lang={lang} title={ui.review}>
  <h1 class="mb-2 text-3xl font-semibold">{ui.review}</h1>
  <p class="mb-6 max-w-2xl text-muted">{ui.reviewIntro}</p>
  <p class="mb-2 text-sm text-fg-soft">{`${reviewed} / ${terms.length} ${ui.reviewed}`}</p>
  <div class="mb-10 h-1.5 w-full max-w-md rounded bg-surface-2">
    <div
      class="h-1.5 rounded bg-green-600"
      style={`width: ${(reviewed / terms.length) * 100}%`}
    ></div>
  </div>
  {clusters.map(([cluster, items]) => (
    <section class="mb-8">
      <SectionHeading class="mb-3">
        {clusterLabel(cluster, lang)} · {items.length}
      </SectionHeading>
      <ul class="space-y-1 text-sm">
        {items
          .sort((a, b) => a.data.term[lang].localeCompare(b.data.term[lang], lang))
          .map((t) => (
            <li class="flex flex-wrap items-baseline gap-x-3">
              <a
                class="inline-flex min-h-11 items-center text-fg hover:underline sm:min-h-0"
                href={termUrl(lang, t.id)}
              >
                {t.data.term[lang]}
              </a>
              <a
                class="inline-flex min-h-11 items-center text-xs text-subtle hover:text-fg-soft sm:min-h-0"
                href={editUrl(t.id)}
              >
                {ui.editOnGitHub}
              </a>
            </li>
          ))}
      </ul>
    </section>
  ))}
</Base>

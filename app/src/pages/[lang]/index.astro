---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Search from '../../components/Search';
import RecentTerms from '../../components/RecentTerms';
import PillLink from '../../components/PillLink.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import {
  LANGS,
  SEMANTIC_SEARCH_URL,
  UI,
  clusterLabel,
  domainLabel,
  termUrl,
  url,
  type Lang,
} from '../../lib/site';
import { UI_EXTRA } from '../../lib/ui-extra';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const ui = UI[lang];
const terms = await getCollection('terms');

// Group by primary domain (folder), then cluster.
const domains = new Map<string, Map<string, typeof terms>>();
for (const t of terms) {
  const domain = t.id.split('/')[0];
  const clusters = domains.get(domain) ?? new Map();
  clusters.set(t.data.cluster, [...(clusters.get(t.data.cluster) ?? []), t]);
  domains.set(domain, clusters);
}
const byName = (a: (typeof terms)[number], b: (typeof terms)[number]) =>
  a.data.term[lang].localeCompare(b.data.term[lang], lang);
const count = (clusters: Map<string, typeof terms>) =>
  [...clusters.values()].reduce((n, items) => n + items.length, 0);
const names = Object.fromEntries(terms.map((t) => [t.id, t.data.term[lang]]));
const ids = terms.map((t) => t.id);
---

<Base lang={lang}>
  <section class="mb-12">
    <h1 class="mb-2 text-4xl font-semibold tracking-tight">Atlas</h1>
    <p class="text-lg text-fg-soft">{ui.tagline}</p>
    <p class="mt-3 max-w-2xl text-muted">{ui.heroLead}</p>
    <p class="mt-3 flex items-start gap-2 rounded-xl border border-border px-3 py-2 text-sm text-fg-soft sm:inline-flex sm:items-center sm:rounded-full sm:py-1">
      <span aria-hidden="true" class="shrink-0">
        ♥
      </span>
      {ui.freeForever}
    </p>
    <div class="mt-8">
      <Search
        client:load
        lang={lang}
        indexUrl={url('search-index.json')}
        semanticUrl={SEMANTIC_SEARCH_URL}
        langBase={url(`${lang}/`)}
        placeholder={ui.search}
        noResults={ui.noResults}
        loadingLabel={ui.loading}
        hint={ui.searchHint}
        intentLabels={{ compare: ui.intentCompare, route: ui.intentRoute, before: ui.intentBefore }}
        disambiguationLabel={ui.searchDisambiguation}
        byMeaningLabel={ui.semanticByMeaning}
      />
    </div>
  </section>

  <section id="browse" class="mb-14">
    <SectionHeading class="mb-4">{ui.browseDomains}</SectionHeading>
    <ul class="grid grid-cols-2 gap-3 lg:grid-cols-4">
      {[...domains.entries()].map(([domain, clusters]) => (
        <li>
          <a
            href={`#domain-${domain}`}
            class="block h-full rounded border border-border p-4 hover:border-border-hover"
          >
            <span class="block text-lg font-medium text-fg">{domainLabel(domain, lang)}</span>
            <span class="mt-1 block text-sm text-subtle">
              {ui.termCount.replace('{n}', String(count(clusters)))} ·{' '}
              {ui.clusterCount.replace('{n}', String(clusters.size))}
            </span>
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-4 flex flex-wrap gap-2 text-sm">
      <PillLink id="random-term" href={termUrl(lang, ids[0])} data-ids={JSON.stringify(ids)}>
        {`⚄ ${ui.randomTerm}`}
      </PillLink>
      <PillLink href={url(`${lang}/explorer/`)}>{ui.explorer} →</PillLink>
      <PillLink href={url(`${lang}/study/`)}>{ui.study} →</PillLink>
      <PillLink href={url(`${lang}/terms/`)}>{UI_EXTRA[lang].azTitle} →</PillLink>
    </div>
    <RecentTerms
      client:only="preact"
      names={names}
      termBase={url(`${lang}/terms/`)}
      ui={{ recentlyViewed: ui.recentlyViewed, clearRecent: ui.clearRecent }}
    />
  </section>

  <h2 class="mb-8 border-t border-border pt-10 text-2xl font-semibold">{ui.indexTitle}</h2>
  {[...domains.entries()].map(([domain, clusters]) => (
    <section class="mb-12 scroll-mt-6" id={`domain-${domain}`}>
      <h3 class="mb-6 text-xl font-semibold">{domainLabel(domain, lang)}</h3>
      {[...clusters.entries()].map(([cluster, items]) => (
        <div class="mb-8 scroll-mt-6" id={`cluster-${domain}-${cluster}`}>
          <SectionHeading as="h4" class="mb-3">
            {clusterLabel(cluster, lang)} · {items.length}
          </SectionHeading>
          <ul class="gap-x-12 xl:columns-2">
            {items.sort(byName).map((t) => (
              <li class="mb-2 break-inside-avoid">
                <a class="text-fg hover:underline" href={termUrl(lang, t.id)}>
                  {t.data.term[lang]}
                </a>
                <span class="text-muted"> - {t.data.summary[lang]}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  ))}
</Base>

<script>
  // A random entry: the link works without JavaScript (first term); with it, any term.
  const link = document.getElementById('random-term') as HTMLAnchorElement | null;
  link?.addEventListener('click', (e) => {
    const ids = JSON.parse(link.dataset.ids ?? '[]') as string[];
    if (ids.length === 0) return;
    e.preventDefault();
    const id = ids[Math.floor(Math.random() * ids.length)];
    location.href = link.href.replace(/terms\/.*$/, `terms/${id}/`);
  });
</script>

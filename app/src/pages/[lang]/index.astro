---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'da' } }];
}

const lang = (Astro.params.lang ?? 'en') as 'en' | 'da';
const terms = await getCollection('terms');

const byCluster = new Map<string, typeof terms>();
for (const t of terms) {
  const list = byCluster.get(t.data.cluster) ?? [];
  list.push(t);
  byCluster.set(t.data.cluster, list);
}
const clusters = [...byCluster.entries()].sort((a, b) => a[0].localeCompare(b[0]));

const tagline =
  lang === 'da'
    ? 'En tosproget teknisk ordbog, der læses som en vidensgraf.'
    : 'A bilingual technical dictionary that reads as a knowledge graph.';
---

<Base lang={lang} title="Atlas">
  <h1 class="mb-2 text-3xl font-semibold">Atlas</h1>
  <p class="mb-10 text-neutral-400">{tagline}</p>
  {
    clusters.map(([cluster, items]) => (
      <section class="mb-8">
        <h2 class="mb-3 text-xs tracking-widest text-neutral-500 uppercase">{cluster}</h2>
        <ul class="space-y-2">
          {items.map((t) => (
            <li>
              <a class="text-neutral-100 hover:underline" href={`/${lang}/terms/${t.id}/`}>
                {t.data.term[lang]}
              </a>
              <span class="text-neutral-500"> — {t.data.summary[lang]}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

---
import Base from '../../../layouts/Base.astro';
import Account from '../../../components/Account';
import { ACCOUNTS, LANGS, UI, url, type Lang } from '../../../lib/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const ui = UI[lang];
---

<Base lang={lang} title={ui.account}>
  <h1 class="mb-2 text-3xl font-semibold">{ui.account}</h1>
  {ACCOUNTS ? (
    <>
      <p class="mb-10 text-muted">{ui.accountIntro}</p>
      <Account client:only="preact" lang={lang} ui={{ ...ui }} />
    </>
  ) : (
    <p class="text-muted">{ui.accountsOff}</p>
  )}
  <p class="mt-10 text-sm text-subtle">
    <a class="underline hover:text-fg-soft" href={url(`${lang}/privacy/`)}>
      {ui.privacyLink}
    </a>
  </p>
</Base>

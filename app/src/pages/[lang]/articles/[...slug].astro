---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { UI, termUrl, type Lang } from '../../../lib/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((a) => ({
    params: { lang: a.data.lang, slug: a.data.term },
    props: { article: a },
  }));
}

const lang = Astro.params.lang as Lang;
const { article } = Astro.props;
const { Content } = await render(article);
---

<Base lang={lang} title={article.data.title}>
  <a
    class="text-sm text-neutral-400 hover:text-neutral-100"
    href={termUrl(lang, article.data.term)}
  >
    {UI[lang].backToTerm}
  </a>
  <article class="prose-atlas mt-6 space-y-4 leading-relaxed text-neutral-200 [&_a]:underline [&_h1]:text-3xl [&_h1]:font-semibold [&_h1]:text-neutral-100 [&_h2]:mt-8 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-neutral-100 [&_h3]:mt-6 [&_h3]:font-semibold [&_li]:ml-5 [&_ol]:list-decimal [&_table]:w-full [&_td]:border [&_td]:border-neutral-800 [&_td]:px-2 [&_td]:py-1 [&_th]:border [&_th]:border-neutral-800 [&_th]:px-2 [&_th]:py-1 [&_th]:text-left [&_ul]:list-disc">
    <Content />
  </article>
</Base>

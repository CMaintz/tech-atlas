---
import Base from '../../../layouts/Base.astro';
import Timeline, { type TimelineEntry } from '../../../components/Timeline';
import { groupByDecade } from '../../../lib/era';
import { loadGraph } from '../../../lib/graph';
import type { GraphNode } from '../../../lib/graph-model';
import { domainColour, homeDomain } from '../../../lib/graph-style';
import {
  CLUSTER_LABELS,
  DOMAIN_LABELS,
  FAMILY_LABELS,
  GRAPH_UI,
  LANGS,
  TIMELINE_UI,
  UI,
  termUrl,
  url,
  type Lang,
} from '../../../lib/site';
import { localise, panelConfig } from '../../../lib/panel-config';
import { axisRange, milestones, type TimelineItem } from '../../../lib/timeline';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const ui = UI[lang];
const tl = TIMELINE_UI[lang];
const graph = await loadGraph();
const nodes: GraphNode[] = graph.nodes;

// Swim-lane timeline (Timeline v2): every dated term in its domain's lane, coloured by
// domain like the graph (A74); the most connected terms are emphasised as milestones.
const dated: TimelineItem[] = nodes
  .filter((n) => n.era !== undefined)
  .map((n) => ({
    id: n.id,
    name: n.term[lang],
    year: n.era!,
    domain: n.domain,
    home: homeDomain(n),
    degree: n.degree,
  }));
const hubs = milestones(dated);
const summaries = new Map<string, string>(nodes.map((n) => [n.id, n.summary?.[lang] ?? '']));
const items: TimelineEntry[] = dated.map((t) => ({
  ...t,
  summary: summaries.get(t.id) ?? '',
  href: termUrl(lang, t.id),
  hub: hubs.has(t.id),
}));
const undated = nodes.length - dated.length;
const order = ['security', 'cs', 'ai', 'platform'];
const domains = [...new Set(dated.map((t) => t.home))].sort(
  (a, b) => (order.indexOf(a) + 1 || 99) - (order.indexOf(b) + 1 || 99) || a.localeCompare(b),
);
const domainLabels = Object.fromEntries(
  Object.entries(DOMAIN_LABELS).map(([d, l]) => [d, l[lang]]),
);
const domainColours = Object.fromEntries(
  [...new Set([...domains, ...dated.flatMap((t) => t.domain)])].map((d) => [d, domainColour(d)]),
);
const range = axisRange(dated.map((t) => t.year));

// The accessible list view: every dated term by decade (also the no-JavaScript fallback
// for the phone layout's short names).
const { decades } = groupByDecade(
  items.map((t) => ({ ...t, era: t.year })),
  (t) => t.name,
);
const { eras, ...tlText } = tl;

// Clicking a term opens the Explorer's term panel (A80), loaded on demand.
const panel = {
  ...panelConfig(lang),
  lang,
  termBase: url(`${lang}/terms/`),
  clusterLabels: localise(CLUSTER_LABELS, lang),
  familyLabels: localise(FAMILY_LABELS, lang),
  graphUi: { ...GRAPH_UI[lang] },
};
---

<Base lang={lang} title={ui.timeline}>
  <div>
    <h1 class="mb-2 text-3xl font-semibold">{ui.timeline}</h1>
    <p class="mb-2 max-w-3xl text-neutral-400">{ui.timelineIntro}</p>
    {undated > 0 && (
      <p class="mb-6 text-sm text-neutral-500">
        {undated === 1 ? ui.undatedNoteOne : ui.undatedNote.replace('{n}', String(undated))}
      </p>
    )}
    {items.length === 0 && <p class="text-neutral-400">{ui.noDated}</p>}
    {items.length > 0 && (
      <div
        id="timeline"
        class="sm:ml-[calc(50%-min(800px,50vw-1rem))] sm:w-[min(1600px,calc(100vw-2rem))]"
      >
        <Timeline
          client:idle
          items={items}
          domains={domains}
          domainLabels={domainLabels}
          domainColours={domainColours}
          range={range}
          eraLabels={eras}
          text={{ ...tlText, allDomains: ui.allDomains }}
          panel={panel}
        />
        <details class="mt-8 rounded-lg border border-neutral-800 p-4">
          <summary class="cursor-pointer text-sm text-neutral-300">{tl.listView}</summary>
          <ol class="mt-4 space-y-6">
            {decades.map(({ decade, items: list }) => (
              <li class="list-none">
                <h2 class="mb-2 font-mono text-neutral-200">
                  {ui.decade.replace('{d}', String(decade))}
                </h2>
                <ul class="gap-x-6 space-y-1 sm:columns-2 lg:columns-3">
                  {list.map((t) => (
                    <li class="flex break-inside-avoid items-baseline gap-2 text-sm">
                      <span class="w-10 shrink-0 font-mono text-xs text-neutral-500">{t.year}</span>
                      <span
                        aria-hidden="true"
                        class="inline-block h-2 w-2 shrink-0 rounded-full"
                        style={{ background: domainColours[t.home] }}
                      />
                      <a class="text-neutral-100 hover:underline" href={t.href}>
                        {t.name}
                      </a>
                      <span class="sr-only">
                        ({t.domain.map((d) => domainLabels[d] ?? d).join(', ')})
                      </span>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        </details>
      </div>
    )}
  </div>
</Base>

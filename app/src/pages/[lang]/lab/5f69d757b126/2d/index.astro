---
/**
 * The visual lab, 2D (A95): the real Explorer with a floating panel that swaps in old
 * visual effects live, a frame meter and a scripted benchmark. Obscure, not secret (the
 * repo is public): linked from nowhere, noindex (so out of the sitemap), no tour.
 */
import Base from '../../../../../layouts/Base.astro';
import ExplorerLab from '../../../../../components/ExplorerLab';
import AboutButton from '../../../../../components/AboutButton';
import { aboutProps } from '../../../../../lib/about-assets';
import {
  CLUSTER_LABELS,
  DOMAIN_LABELS,
  FAMILY_COLOURS,
  FAMILY_LABELS,
  GRAPH_UI,
  LANGS,
  UI,
  url,
  type Lang,
} from '../../../../../lib/site';
import { localise as localiseIn, panelConfig } from '../../../../../lib/panel-config';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const ui = UI[lang];
const localise = (m: Record<string, Record<Lang, string>>) => localiseIn(m, lang);

// The term panel (A80) gets its tables from here, so the island never bundles the schema.
const panel = panelConfig(lang);
const about = aboutProps(lang);
---

<Base lang={lang} title="Visual lab 2D" wide noindex tourAutoStart={false}>
  {/* The map stays a dark "night map" in the light theme (A92). */}
  <div id="explorer" data-theme="dark" class="bg-bg text-fg">
    <ExplorerLab
      client:only="preact"
      view="2d"
      lang={lang}
      graphUrl={url('graph.json')}
      termBase={url(`${lang}/terms/`)}
      ui={{ ...ui }}
      clusterLabels={localise(CLUSTER_LABELS)}
      graphUi={{ ...GRAPH_UI[lang] }}
      familyLabels={localise(FAMILY_LABELS)}
      familyColours={FAMILY_COLOURS}
      domainLabels={localise(DOMAIN_LABELS)}
      panel={panel}
    />
    <div class="absolute top-3 right-3 z-10" data-about-corner>
      <AboutButton client:idle {...about} />
    </div>
  </div>
</Base>

<style is:global>
  /*
   * The About button (A84) owns the map's top-right corner; the floating control bar
   * (A93) is centred between insets that keep it clear of the button.
   */
  #explorer {
    position: relative;
  }
  #explorer [data-about-corner] {
    transition:
      right 300ms ease-out,
      top 300ms ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    #explorer [data-about-corner] {
      transition: none;
    }
  }
  /*
   * The term panel (A80) must never hide the "i". Full width (phones, or expanded), the
   * button sits above the panel and the panel's header row keeps its corner clear;
   * docked on a wide screen, the button moves left of the panel and down below the bar
   * row, which stays put under the panel (A93a) — so the two never overlap.
   */
  #explorer:has([data-term-panel]) [data-about-corner] {
    z-index: 30;
  }
  #explorer [data-term-panel] > div:first-child {
    padding-right: 3.5rem;
  }
  @media (min-width: 1024px) {
    #explorer:has([data-term-panel]:not([data-expanded])) [data-about-corner] {
      right: calc(26rem + 0.75rem);
      top: 3.75rem;
    }
    #explorer [data-term-panel]:not([data-expanded]) > div:first-child {
      padding-right: 1rem;
    }
  }
</style>

---
/**
 * The visual lab, 3D: the real Explorer with a floating panel that swaps in old
 * visual effects live, a frame meter and a scripted benchmark. Obscure, not secret (the
 * repo is public): linked from nowhere, noindex (so out of the sitemap), no tour.
 */
import Base from '../../../../../layouts/Base.astro';
import ExplorerLab from '../../../../../components/ExplorerLab';
import ExplorerStage from '../../../../../components/ExplorerStage.astro';
import { mapIslandProps } from '../../../../../lib/map-props';
import { LANGS, SEMANTIC_SEARCH_URL, type Lang } from '../../../../../lib/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Base lang={lang} title="Visual lab 3D" wide noindex tourAutoStart={false}>
  <ExplorerStage lang={lang}>
    <ExplorerLab
      client:only="preact"
      view="3d"
      lang={lang}
      {...mapIslandProps(lang)}
      semanticUrl={SEMANTIC_SEARCH_URL}
    />
  </ExplorerStage>
</Base>

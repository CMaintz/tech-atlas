---
/**
 * Disambiguation (ADR-0003): the bare name of a Collision — `/[lang]/terms/audit/` —
 * lists every Term that answers to it. Generated from the folder namespaces, never
 * authored. Every other short name (a bare id, display name or alias) redirects to
 * its one Term.
 */
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { collisionsOf } from '../../../lib/collisions';
import { shortNames } from '../../../lib/redirects';
import Redirect from '../../../components/Redirect.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import { LANGS, UI, clusterLabel, domainLabel, termUrl, type Lang } from '../../../lib/site';

export async function getStaticPaths() {
  const terms = await getCollection('terms');
  const collisions = collisionsOf(terms.map((t) => t.id));
  return LANGS.flatMap((lang) => [
    ...[...collisions.entries()].map(([name, ids]) => ({
      params: { lang, name },
      props: { ids, target: undefined },
    })),
    ...[...shortNames(terms.map((t) => ({ id: t.id, ...t.data })))].map(([name, target]) => ({
      params: { lang, name },
      props: { ids: [] as string[], target },
    })),
  ]);
}

const lang = Astro.params.lang as Lang;
const name = Astro.params.name as string;
const ui = UI[lang];
const { ids, target } = Astro.props;
const all = await getCollection('terms');
const meanings = ids.map((id) => all.find((t) => t.id === id)!);
const label = name.replace(/-/g, ' ');
const title = ui.disambiguationTitle.replace('{name}', label);
---

{target ? (
  <Redirect
    lang={lang}
    to={termUrl(lang, target)}
    title={all.find((t) => t.id === target)!.data.term[lang]}
  />
) : (
  <Base lang={lang} title={title} description={ui.disambiguationIntro.replace('{name}', label)}>
    <h1 class="mb-2 text-3xl font-semibold">{title}</h1>
    <p class="mb-8 text-muted">{ui.disambiguationIntro.replace('{name}', label)}</p>
    <ul class="space-y-4">
      {meanings.map((t) => (
        <li class="rounded border border-border p-4">
          <SectionHeading as="div" class="mb-1">
            {t.data.domain.map((x) => domainLabel(x, lang)).join(' · ')} ·{' '}
            {clusterLabel(t.data.cluster, lang)}
          </SectionHeading>
          <a class="text-lg text-fg hover:underline" href={termUrl(lang, t.id)}>
            {t.data.term[lang]}
          </a>
          <p class="mt-1 text-muted">{t.data.summary[lang]}</p>
        </li>
      ))}
    </ul>
  </Base>
)}

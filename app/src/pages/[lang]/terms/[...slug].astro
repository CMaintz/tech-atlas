---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { LANGS, type Lang } from '../../../lib/site';
import { relationsOf } from '../../../lib/terms';
import { loadGraph } from '../../../lib/graph';
import { makeLinker, type Segment } from '../../../lib/autolink';
import { paragraphs } from '../../../lib/term-panel';
import { FACETS, termJsonLd, type Facet } from '../../../lib/term-page';
import TermHero from '../../../components/term/TermHero.astro';
import TermFacets from '../../../components/term/TermFacets.astro';
import DeepDive from '../../../components/term/DeepDive.astro';
import LearnFirst from '../../../components/term/LearnFirst.astro';
import TermRelations from '../../../components/term/TermRelations.astro';
import ContinueLearning from '../../../components/term/ContinueLearning.astro';
import Mentions from '../../../components/term/Mentions.astro';
import CheckYourself from '../../../components/term/CheckYourself.astro';
import TermConnections from '../../../components/term/TermConnections.astro';

export async function getStaticPaths() {
  const terms = await getCollection('terms');
  return LANGS.flatMap((lang) =>
    terms.map((t) => ({ params: { lang, slug: t.id }, props: { termId: t.id } })),
  );
}

const lang = Astro.params.lang as Lang;
const { termId } = Astro.props;
const all = await getCollection('terms');
const term = all.find((t) => t.id === termId)!;
const d = term.data;
const relations = relationsOf(term, all);
const graph = await loadGraph();

// Auto-link other terms in the body — first mention per page (SPEC §4): the facets,
// then the technical deep dive (A80), one paragraph per blank-line block.
const linker = makeLinker(
  all.map((t) => ({ id: t.id, term: t.data.term, aka: t.data.aka })),
  lang,
);
const seen = new Set<string>();
const linked = Object.fromEntries(
  FACETS.map((f) => [f, linker.link(d.body[f][lang], { self: term.id, seen })]),
) as Record<Facet, Segment[]>;
const deepDive = paragraphs(d.deepDive?.[lang]).map((p) => linker.link(p, { self: term.id, seen }));
---

<Base
  lang={lang}
  title={d.term[lang]}
  description={d.summary[lang]}
  ogType="article"
  jsonLd={termJsonLd(term, lang, Astro.site)}
>
  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-10" data-term-id={term.id}>
    <div>
      <TermHero lang={lang} term={term} all={all} />
      <TermFacets lang={lang} linked={linked} />
      <DeepDive lang={lang} paragraphs={deepDive} />
      <LearnFirst lang={lang} term={term} graph={graph} />
      <TermRelations lang={lang} term={term} relations={relations} />
      <ContinueLearning lang={lang} term={term} />
      <Mentions lang={lang} term={term} relations={relations} graph={graph} />
      <CheckYourself lang={lang} termId={term.id} />
    </div>
    <TermConnections lang={lang} term={term} relations={relations} />
  </div>
</Base>

<script>
  import { RECENT_KEY, parseRecent, pushRecent } from '../../../lib/prefs';

  // Recently viewed (A62) — shown on the home page.
  const id = document.querySelector<HTMLElement>('[data-term-id]')?.dataset.termId;
  try {
    if (id) {
      const list = pushRecent(parseRecent(localStorage.getItem(RECENT_KEY)), id);
      localStorage.setItem(RECENT_KEY, JSON.stringify(list));
    }
  } catch {
    /* storage unavailable: nothing remembered */
  }
</script>

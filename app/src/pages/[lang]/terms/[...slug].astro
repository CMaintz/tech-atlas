---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Graph from '../../../components/Graph';
import {
  CLUSTER_LABELS,
  DOMAIN_LABELS,
  LANGS,
  UI,
  termUrl,
  url,
  type Lang,
} from '../../../lib/site';
import { EDGE_LABELS, RELATION_ORDER, pairSlug, relationsOf } from '../../../lib/terms';

export async function getStaticPaths() {
  const terms = await getCollection('terms');
  return LANGS.flatMap((lang) =>
    terms.map((t) => ({ params: { lang, slug: t.id }, props: { termId: t.id } })),
  );
}

const lang = Astro.params.lang as Lang;
const ui = UI[lang];
const { termId } = Astro.props;
const all = await getCollection('terms');
const term = all.find((t) => t.id === termId)!;
const d = term.data;
const relations = relationsOf(term, all);

// Group relations by type, in a stable reading order.
const groups = RELATION_ORDER.map((type) => ({
  type,
  items: relations.filter((r) => r.type === type),
})).filter((g) => g.items.length > 0);

// Neighbourhood graph: this term + every directly related term.
const nodes = new Map([[term.id, { id: term.id, label: d.term[lang], focus: true }]]);
for (const r of relations) {
  nodes.set(r.target.id, { id: r.target.id, label: r.target.data.term[lang], focus: false });
}
// Every relation is phrased from this term's point of view (inverses already applied),
// so every edge points outward from it.
const edges = relations.map((r) => ({ source: term.id, target: r.target.id, type: r.type }));

const facets = ['formal', 'plain', 'inPractice', 'whyItMatters'] as const;
const aka = d.aka[lang];
---

<Base lang={lang} title={d.term[lang]} description={d.summary[lang]}>
  <div class="mb-1 text-xs tracking-widest text-neutral-500 uppercase">
    {d.domain.map((x) => DOMAIN_LABELS[x]?.[lang] ?? x).join(' · ')} · {
      CLUSTER_LABELS[d.cluster]?.[lang] ?? d.cluster
    }
  </div>
  <h1 class="text-3xl font-semibold">{d.term[lang]}</h1>
  {
    aka.length > 0 && (
      <p class="mt-1 text-sm text-neutral-500">
        {ui.aka}: {aka.join(', ')}
      </p>
    )
  }
  <p class="mt-3 text-lg text-neutral-300">{d.summary[lang]}</p>

  {
    d.draft && (
      <p class="mt-4 rounded border border-amber-900 bg-amber-950/40 px-3 py-2 text-sm text-amber-300">
        {ui.draft}
      </p>
    )
  }

  <div class="mt-8 space-y-5">
    {
      facets.map((f) => (
        <div>
          <h2 class="mb-1 text-xs tracking-widest text-neutral-500 uppercase">{ui[f]}</h2>
          <p class="text-neutral-200">{d.body[f][lang]}</p>
        </div>
      ))
    }
  </div>

  {
    groups.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-3 text-xs tracking-widest text-neutral-500 uppercase">{ui.relationships}</h2>
        <dl class="space-y-3">
          {groups.map((g) => (
            <div>
              <dt class="text-sm text-neutral-400">{EDGE_LABELS[g.type]?.[lang] ?? g.type}</dt>
              <dd class="mt-1 flex flex-wrap gap-2">
                {g.items.map((r) => (
                  <a
                    href={
                      g.type === 'contrasts-with'
                        ? url(`${lang}/compare/${pairSlug(term, r.target)}/`)
                        : termUrl(lang, r.target.id)
                    }
                    title={r.why?.[lang]}
                    class:list={[
                      'rounded border px-2 py-1 text-sm hover:border-neutral-400',
                      r.strength === 'primary'
                        ? 'border-neutral-500 text-neutral-100'
                        : 'border-neutral-800 text-neutral-300',
                    ]}
                  >
                    {r.target.data.term[lang]}
                  </a>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <h2 class="mt-10 mb-2 text-xs tracking-widest text-neutral-500 uppercase">{ui.connections}</h2>
  <Graph
    client:only="preact"
    nodes={[...nodes.values()]}
    edges={edges}
    termBase={url(`${lang}/terms/`)}
  />

  <div class="mt-8 text-sm text-neutral-500">
    <span class="text-xs tracking-widest uppercase">{ui.sources}</span>
    <ul class="mt-1 list-inside list-disc">
      {
        d.sources.map((s) => (
          <li>
            {s.url ? (
              <a class="hover:text-neutral-300 hover:underline" href={s.url}>
                {s.title}
              </a>
            ) : (
              s.title
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Graph from '../../../components/Graph';
import KnowledgeStatus from '../../../components/KnowledgeStatus';
import Quiz from '../../../components/Quiz';
import {
  CLUSTER_COLOURS,
  CLUSTER_LABELS,
  DOMAIN_LABELS,
  LANGS,
  UI,
  termUrl,
  url,
  type Lang,
} from '../../../lib/site';
import { EDGE_LABELS, RELATION_ORDER, pairSlug, relationsOf } from '../../../lib/terms';
import { loadGraph } from '../../../lib/graph';
import { prerequisitesOf } from '../../../lib/graph-model';
import { makeLinker } from '../../../lib/autolink';
import Prose from '../../../components/Prose.astro';

export async function getStaticPaths() {
  const terms = await getCollection('terms');
  return LANGS.flatMap((lang) =>
    terms.map((t) => ({ params: { lang, slug: t.id }, props: { termId: t.id } })),
  );
}

const lang = Astro.params.lang as Lang;
const ui = UI[lang];
const { termId } = Astro.props;
const all = await getCollection('terms');
const term = all.find((t) => t.id === termId)!;
const d = term.data;
const relations = relationsOf(term, all);

// Group relations by type, in a stable reading order.
const groups = RELATION_ORDER.map((type) => ({
  type,
  items: relations.filter((r) => r.type === type),
})).filter((g) => g.items.length > 0);

// Neighbourhood graph: this term + every directly related term.
const colour = (c: string) => CLUSTER_COLOURS[c] ?? '#a3a3a3';
const nodes = new Map([
  [term.id, { id: term.id, label: d.term[lang], focus: true, colour: colour(d.cluster) }],
]);
for (const r of relations) {
  nodes.set(r.target.id, {
    id: r.target.id,
    label: r.target.data.term[lang],
    focus: false,
    colour: colour(r.target.data.cluster),
  });
}
// Every relation is phrased from this term's point of view (inverses already applied),
// so every edge points outward from it.
const edges = relations.map((r) => ({
  source: term.id,
  target: r.target.id,
  type: EDGE_LABELS[r.type]?.[lang] ?? r.type,
}));

const facets = ['formal', 'plain', 'inPractice', 'whyItMatters'] as const;
const graph = await loadGraph();
const learnFirst = prerequisitesOf(graph, term.id);

// Auto-link other terms in the body — first mention per page (SPEC §4).
const linker = makeLinker(
  all.map((t) => ({ id: t.id, term: t.data.term, aka: t.data.aka })),
  lang,
);
const seen = new Set<string>();
const linked = Object.fromEntries(
  facets.map((f) => [f, linker.link(d.body[f][lang], { self: term.id, seen })]),
);

// Mentions: entries whose prose names this term but that aren't otherwise related (SPEC §6).
const related = new Set(relations.map((r) => r.target.id));
const mentionedIn = graph.nodes.filter(
  (n) => n.id !== term.id && n.mentions.includes(term.id) && !related.has(n.id),
);
const aka = d.aka[lang];
---

<Base lang={lang} title={d.term[lang]} description={d.summary[lang]}>
  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-10">
    <div>
      <div class="mb-1 text-xs tracking-widest text-neutral-500 uppercase">
        {d.domain.map((x) => DOMAIN_LABELS[x]?.[lang] ?? x).join(' · ')} · {
          CLUSTER_LABELS[d.cluster]?.[lang] ?? d.cluster
        }
      </div>
      <h1 class="text-3xl font-semibold">{d.term[lang]}</h1>
      {
        aka.length > 0 && (
          <p class="mt-1 text-sm text-neutral-500">
            {ui.aka}: {aka.join(', ')}
          </p>
        )
      }
      <p class="mt-3 text-lg text-neutral-300">{d.summary[lang]}</p>

      {
        d.draft && (
          <p class="mt-4 rounded border border-amber-900 bg-amber-950/40 px-3 py-2 text-sm text-amber-300">
            {ui.draft}
          </p>
        )
      }

      {
        d.article?.[lang] && (
          <p class="mt-6">
            <a
              class="text-neutral-100 underline hover:text-white"
              href={url(`${lang}/articles/${term.id}/`)}
            >
              {ui.readArticle}
            </a>
          </p>
        )
      }

      <div class="mt-8 space-y-5">
        {
          facets.map((f) => (
            <div>
              <h2 class="mb-1 text-xs tracking-widest text-neutral-500 uppercase">{ui[f]}</h2>
              <p class="text-neutral-200">
                <Prose segments={linked[f]} lang={lang} />
              </p>
            </div>
          ))
        }
      </div>

      {
        learnFirst.length > 0 && (
          <section class="mt-10">
            <h2 class="mb-1 text-xs tracking-widest text-neutral-500 uppercase">{ui.learnFirst}</h2>
            <p class="mb-2 text-sm text-neutral-500">{ui.learnFirstIntro}</p>
            <ol class="flex flex-wrap items-center gap-1 text-sm">
              {learnFirst.map((n, i) => (
                <li class="flex items-center gap-1">
                  {i > 0 && <span class="text-neutral-600">→</span>}
                  <a
                    class="rounded border border-neutral-800 px-2 py-1 text-neutral-300 hover:border-neutral-400"
                    href={termUrl(lang, n.id)}
                  >
                    {n.term[lang]}
                  </a>
                </li>
              ))}
              <li class="flex items-center gap-1">
                <span class="text-neutral-600">→</span>
                <span class="rounded border border-neutral-500 px-2 py-1 text-neutral-100">
                  {d.term[lang]}
                </span>
              </li>
            </ol>
          </section>
        )
      }

      {
        groups.length > 0 && (
          <section class="mt-10">
            <h2 class="mb-3 text-xs tracking-widest text-neutral-500 uppercase">
              {ui.relationships}
            </h2>
            <dl class="space-y-3">
              {groups.map((g) => (
                <div>
                  <dt class="text-sm text-neutral-400">{EDGE_LABELS[g.type]?.[lang] ?? g.type}</dt>
                  <dd class="mt-1 flex flex-wrap gap-2">
                    {g.items.map((r) => (
                      <a
                        href={
                          g.type === 'contrasts-with'
                            ? url(`${lang}/compare/${pairSlug(term, r.target)}/`)
                            : termUrl(lang, r.target.id)
                        }
                        title={r.why?.[lang]}
                        class:list={[
                          'rounded border px-2 py-1 text-sm hover:border-neutral-400',
                          r.strength === 'primary'
                            ? 'border-neutral-500 text-neutral-100'
                            : 'border-neutral-800 text-neutral-300',
                        ]}
                      >
                        {r.target.data.term[lang]}
                      </a>
                    ))}
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      <div class="mt-8 text-sm text-neutral-500">
        <span class="text-xs tracking-widest uppercase">{ui.sources}</span>
        <ul class="mt-1 list-inside list-disc">
          {
            d.sources.map((s) => (
              <li>
                {s.url ? (
                  <a class="hover:text-neutral-300 hover:underline" href={s.url}>
                    {s.title}
                  </a>
                ) : (
                  s.title
                )}
              </li>
            ))
          }
        </ul>
      </div>
      {
        mentionedIn.length > 0 && (
          <section class="mt-8">
            <h2 class="mb-2 text-xs tracking-widest text-neutral-500 uppercase">
              {ui.mentionedIn}
            </h2>
            <div class="flex flex-wrap gap-2">
              {mentionedIn.map((n) => (
                <a
                  class="rounded border border-dashed border-neutral-800 px-2 py-1 text-sm text-neutral-400 hover:border-neutral-500"
                  href={termUrl(lang, n.id)}
                >
                  {n.term[lang]}
                </a>
              ))}
            </div>
          </section>
        )
      }

      <section class="mt-10 space-y-5 rounded border border-neutral-800 p-4">
        <h2 class="text-xs tracking-widest text-neutral-500 uppercase">{ui.checkYourself}</h2>
        <KnowledgeStatus client:only="preact" termId={term.id} ui={{ ...ui }} />
        <Quiz
          client:visible
          lang={lang}
          graphUrl={url('graph.json')}
          termBase={url(`${lang}/terms/`)}
          ui={{ ...ui }}
          termId={term.id}
          count={3}
        />
      </section>
    </div>
    <aside class="mt-10 lg:sticky lg:top-6 lg:mt-0 lg:self-start">
      <h2 class="mb-2 text-xs tracking-widest text-neutral-500 uppercase">{ui.connections}</h2>
      <Graph
        client:only="preact"
        nodes={[...nodes.values()]}
        edges={edges}
        termBase={url(`${lang}/terms/`)}
      />

      <a
        class="mt-2 inline-block text-sm text-neutral-400 hover:text-neutral-100"
        href={url(`${lang}/explorer/?focus=${encodeURIComponent(term.id)}`)}
      >
        {ui.openExplorer}
      </a>
    </aside>
  </div>
</Base>

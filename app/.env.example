# Copy to .env to build/run with accounts, synced progress and/or search by meaning
# (see docs/SUPABASE_SETUP.md). All values are public (they ship in the browser bundle).
# Leave them empty for the local-only site.

# Accounts + synced progress: both are needed; otherwise every account surface is left out.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Sign-in buttons, comma-separated: github, linkedin_oidc. Empty = GitHub only. List a
# provider only once it is enabled in Supabase (docs/SUPABASE_SETUP.md step 4).
PUBLIC_AUTH_PROVIDERS=

# Search by meaning: the deployed function, e.g.
# https://<ref>.supabase.co/functions/v1/semantic-search. Empty = name search only.
PUBLIC_SEMANTIC_SEARCH_URL=
